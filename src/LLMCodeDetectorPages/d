def render_sections(sections):
    rows = []
    for title, items in sections:
        rows.append(f'<tr><th class="section" colspan="2">{title}</th></tr>')
        for left, right in items:
            rows.append(f"<tr><td><b>{left}</b></td><td>{right}</td></tr>")
    return "\n".join(rows)


